# Supabase dashboard → Project Settings → API
# Copie este arquivo para .env.local e preencha somente na cópia local.
# Never put the service_role key in a VITE_* variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
